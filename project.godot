; 《寒潮清单》Coldfront Checklist — 工程底座配置
; 阶段：v0.1 工程准备（不含正式玩法内容，剧情/道具/购物/建造暂停至 v1.1）
; 修改约定见 docs/开发说明.md

config_version=5

[application]

config/name="寒潮清单 Coldfront Checklist"
config/description="2D 横版像素生存建设游戏：重生七天囤货，把旧小楼改造成安全屋，熬过寒潮。当前为工程底座阶段，玩法内容待 v1.1 交接包。"
config/version="0.1.0"
run/main_scene="res://scenes/dev/test_scene.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[debug]

gdscript/warnings/untyped_declaration=0

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"
window/vsync/vsync_mode=1

