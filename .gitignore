# ---- Godot ----
# 引擎生成的导入缓存与本地配置，不入库（首次打开工程会自动重建）
.godot/
*.translation
# 导出产物
/builds/*
!/builds/.gdignore
/export/

# ---- 本仓库工具链（引擎二进制体积大，不入库）----
.tools/

# ---- 工作区配置（WorkBuddy 项目数据，不入库）----
.workbuddy/

# ---- 交接包原始压缩件（内容已解包进 docs/，不留二进制历史）----
*.zip
*.tpz

# ---- 依赖与构建产物 ----
node_modules/
dist/
build/
.next/
out/

# ---- 环境变量 ----
.env
.env.local
.env.*.local

# ---- 本地临时目录（无头 Chrome profile / 解包缓冲）----
.tmp_*/

# ---- 系统与编辑器 ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log

# ---- 本地临时工作区（解包 / 中间产物），不入库 ----
.work/
